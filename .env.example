# Netlify Functions secret. Generate once; never commit a real value or rotate in place.
SYNC_KEY_ENCRYPTION=
# Netlify Database provisions its own connection; do not commit connection strings.
SEARCH_PROVIDER=deepseek
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# Vercel migration only: public Supabase project configuration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Never put a service_role/secret key or database password in browser configuration.
